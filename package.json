{
  "name": "kyara",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@bloom-perf/hikaku": "^0.2.1",
    "@bloom-perf/yaml-pptr": "^3.1.0",
    "@elastic/ecs-winston-format": "^1.3.1",
    "chalk": "^6.0.1",
    "express": "^5.0.0",
    "prom-client": "^15.0.0",
    "puppeteer": "^25.0.0",
    "winston": "^3.8.2"
  },
  "scripts": {
    "installFirefox": "puppeteer browsers install firefox",
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2"
  }
}
